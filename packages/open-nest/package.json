{
  "name": "open-nest",
  "version": "0.1.0",
  "description": "Run any Nest application as a Web-Standard Request/Response handler.",
  "files": [
    "package.json",
    "readme.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "bun": "./src/fetch/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --clean",
    "dev": "tsdown --watch",
    "typecheck": "bun check",
    "test": "bun test"
  },
  "devDependencies": {
    "@nestjs/platform-express": "12.1.3",
    "@types/express": "5.0.6",
    "express": "5.3.0",
    "helmet": "8.3.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/websockets": "^12.0.0",
    "reflect-metadata": "^0.1.12 || ^0.2.0",
    "rxjs": "^7.1.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/websockets": {
      "optional": true
    }
  }
}
