{
  "name": "@open-nest/workers",
  "version": "0.1.0",
  "description": "Run an open-nest application on Cloudflare Workers.",
  "files": [
    "package.json",
    "readme.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --clean",
    "dev": "tsdown --watch",
    "typecheck": "bun check",
    "test": "bun test"
  },
  "dependencies": {
    "@nats-io/transport-node": "3.4.0",
    "@nestjs/microservices": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/platform-socket.io": "12.1.3",
    "@nestjs/websockets": "12.1.3",
    "amqp-connection-manager": "5.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "ioredis": "6.0.0",
    "kafkajs": "2.2.4",
    "mqtt": "5.16.1",
    "open-nest": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0"
  }
}
