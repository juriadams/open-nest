{
  "name": "@open-nest/node",
  "version": "0.1.0",
  "description": "Run an open-nest application with node:http.",
  "files": [
    "package.json",
    "readme.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --clean",
    "dev": "tsdown --watch",
    "typecheck": "bun check",
    "test": "bun test"
  },
  "dependencies": {
    "open-nest": "workspace:*",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@nestjs/websockets": "12.2.0",
    "@types/ws": "8.18.2"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/websockets": "^12.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/websockets": {
      "optional": true
    }
  }
}
