{
  "name": "open-nest-root",
  "private": true,
  "workspaces": [
    "packages/open-nest",
    "packages/@open-nest/*",
    "examples/*",
    "benchmarks/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "oxlint --type-aware && oxfmt --check",
    "format": "oxlint --fix --fix-suggestions && oxfmt",
    "dev": "turbo run dev",
    "examples:bun": "turbo run start --filter=@open-nest/example-bun",
    "examples:bun-websockets": "turbo run start --filter=@open-nest/example-bun-websockets",
    "examples:node": "turbo run start --filter=@open-nest/example-node",
    "examples:node-websockets": "turbo run start --filter=@open-nest/example-node-websockets",
    "examples:workers": "turbo run start --filter=@open-nest/example-workers",
    "benchmarks:http": "turbo run bench --filter=@open-nest/bench-http"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/websockets": "12.1.3",
    "@types/bun": "latest",
    "@types/node": "26.6.5",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "publint": "0.3.25",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tsdown": "0.23.0",
    "turbo": "2.11.7",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.3"
}
