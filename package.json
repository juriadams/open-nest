{
  "name": "open-nest",
  "version": "0.0.1",
  "description": "Makes Nest applications compatible with Web Standard Request/Response handlers (Bun, Cloudflare, ...).",
  "files": [
    "package.json",
    "readme.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./fastify": {
      "types": "./dist/fastify.d.mts",
      "import": "./dist/fastify.mjs"
    },
    "./express": {
      "types": "./dist/express.d.mts",
      "import": "./dist/express.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown --clean",
    "typecheck": "bun check",
    "test": "bun test",
    "lint": "oxlint --type-aware && oxfmt --check",
    "format": "oxlint --fix --fix-suggestions && oxfmt"
  },
  "dependencies": {
    "light-my-request": "6.8.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/platform-fastify": "12.1.3",
    "@types/bun": "latest",
    "@types/node": "26.6.5",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "publint": "0.3.24",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tsdown": "0.23.0",
    "tsup": "8.5.1",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/platform-fastify": "^12.0.0",
    "reflect-metadata": "^0.1.12 || ^0.2.0",
    "rxjs": "^7.1.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/platform-express": {
      "optional": true
    },
    "@nestjs/platform-fastify": {
      "optional": true
    }
  }
}
